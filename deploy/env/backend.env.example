# Copy this file to deploy/env/backend.env on the EC2 server.
# Never commit the real backend.env file.

NODE_ENV=production
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# PostgreSQL runs inside docker-compose.production.yml.
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
# URL-encode special characters if you use them in DATABASE_URL.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=medusa
DATABASE_URL=postgresql://medusa:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/medusa

# Redis is private to the Docker network.
REDIS_URL=redis://redis:6379

# Production origins. Keep the existing WebCake site online while staging is tested.
STORE_CORS=https://staging.tranhtranvienmetal.com,https://www.tranhtranvienmetal.com
ADMIN_CORS=https://api.tranhtranvienmetal.com
AUTH_CORS=https://staging.tranhtranvienmetal.com,https://www.tranhtranvienmetal.com,https://api.tranhtranvienmetal.com

# Generate two different long random values on the EC2 server.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
COOKIE_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE

# Cloudflare R2 or another S3-compatible file provider.
S3_FILE_URL=https://CHANGE_ME_PUBLIC_MEDIA_HOST
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=auto
S3_BUCKET=CHANGE_ME
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com

# SePay payment provider.
SEPAY_BANK_ACCOUNT_NUMBER=CHANGE_ME
SEPAY_BANK_CODE=CHANGE_ME
SEPAY_ACCOUNT_HOLDER_NAME=CHANGE_ME
SEPAY_API_TOKEN=CHANGE_ME
SEPAY_WEBHOOK_API_KEY=CHANGE_ME
