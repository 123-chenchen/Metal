# Copy this file to deploy/env/storefront.env on the EC2 server.
# Never commit the real storefront.env file.

NODE_ENV=production

# The backend must already be online before building the storefront image.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.tranhtranvienmetal.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=CHANGE_ME_AFTER_CREATING_THE_KEY_IN_MEDUSA_ADMIN
NEXT_PUBLIC_DEFAULT_REGION=vn

# Use staging until the customer approves replacing the existing WebCake site.
NEXT_PUBLIC_BASE_URL=https://staging.tranhtranvienmetal.com

# Optional integrations. Leave empty when unused.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
