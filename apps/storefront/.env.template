# Publishable API key for the Medusa backend. Required for the storefront to function.
# Get this from Admin > Settings > Publishable API keys after starting the backend.
# Learn more: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region country code to use for the storefront.
# Must match a country covered by a Region you have set up in Medusa
# (Admin > Settings > Regions) — otherwise every product page 404s.
NEXT_PUBLIC_DEFAULT_REGION=vn

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname/path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development

# Public base URL for product/media images stored in Cloudflare R2.
# Should match S3_FILE_URL in apps/backend/.env.
NEXT_PUBLIC_MEDIA_URL=
