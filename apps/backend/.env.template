NODE_ENV=development

STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:8000,http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
COOKIE_SECURE=false
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Matches the postgres service in docker-compose.yml (docker compose up -d).
# If you use your own local Postgres instead, point this at that instance.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# Cloudflare R2 (S3-compatible) file storage. In development, leaving these
# empty selects Medusa's local file provider at http://localhost:9000/static.
# Production remains strict and requires all S3 values.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# SePay (VietQR bank-transfer payments, see https://developer.sepay.vn) —
# required for the "sepay" payment provider to appear at checkout.
# Bank account that receives transfers, and its bank code/short name from
# https://qr.sepay.vn (e.g. "vietcombank", "mbbank").
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_HOLDER_NAME=
# API token from the SePay dashboard (Company > API), used to look up
# incoming transactions when authorizing a payment.
SEPAY_API_TOKEN=
# Shared secret configured as the webhook's "API Key" auth in the SePay
# dashboard. SePay must send `Authorization: Apikey <this value>` when
# calling POST /webhooks/sepay.
SEPAY_WEBHOOK_API_KEY=
