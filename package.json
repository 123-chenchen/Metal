{
  "name": "metal",
  "private": false,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:backend": "npm run build --workspace=@dtc/backend",
    "build:storefront": "npm run build --workspace=@dtc/storefront",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "npm run test --workspace=@dtc/backend",
    "ci:test": "npm run test",
    "ci:build": "npm run build:backend && npm run build:storefront",
    "ci": "npm run ci:test && npm run ci:build",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    },
    "@medusajs/dashboard": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
