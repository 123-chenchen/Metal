auto-install-peers=true
# @medusajs/medusa peer-depends on react-dom@^18.3.1 (for the admin Vite
# build) while the storefront needs react/react-dom 19.x - both real
# requirements in this monorepo, not an accidental mismatch. Without this,
# `npm install` refuses with an unresolvable peer conflict the moment root
# gets its own react/react-dom (needed so Next's hoisted-to-root package
# resolves 19.x instead of picking up whichever version wins the backend's
# hoist - see the Next.js 15 + npm workspaces "React error #31 prerendering
# /404" issue).
legacy-peer-deps=true
